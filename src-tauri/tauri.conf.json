{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev-Tools",
  "version": "1.0.0",
  "identifier": "com.xchendev.tools",
  "mainBinaryName": "Dev-Tools",
  "build": {
    "beforeDevCommand": "node scripts/dev-frontend.mjs",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Dev-Tools",
        "width": 1250,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "publisher": "XchenDev",
    "copyright": "Copyright © 2026 XchenDev",
    "homepage": "https://github.com/Pxczxn/Dev-Tools",
    "shortDescription": "Windows 本地开发一体化工具",
    "longDescription": "工作区制本地开发一体化工具：项目发现、服务编排、端口与进程管理。",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
